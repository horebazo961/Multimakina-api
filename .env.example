# ============================================================
# MULTIMAKINA - Environment Variables (copy to .env locally)
# NEVER commit the real .env file
# ============================================================

# Required: PostgreSQL connection string (Supabase Session Pooler recommended)
# Example: postgresql://postgres.xxxxx:password@aws-0-us-west-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# CORS origins (comma-separated). Include your Vercel domain and localhost.
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Optional: JWT secret (generate a long random string)
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
